# PHOTON GLASS: 名前（ホスト名.local）に番号が付いたら元に戻す（photonglass-fixname を動かし続ける）
# setup_pi.sh が /etc/systemd/system/photonglass-fixname.service に置きます。
[Unit]
Description=PHOTON GLASS: keep hostname.local without a -2 suffix
Wants=network-online.target
After=network-online.target avahi-daemon.service

[Service]
ExecStart=/usr/local/bin/photonglass-fixname
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
