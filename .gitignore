# Google Cloud の API キー（公開しない）
api_key.txt

# 秘密の情報（API キー、Wi-Fi のパスワードなど）を書いたファイル（公開しない）
.env
secrets*

# プログラムが作るファイル（撮った写真と読み上げ音声。公開しない）
image.jpg
speech.wav

# Python のキャッシュ・仮想環境
__pycache__/
*.pyc
.venv/

# CadQuery のスクリプトが作るファイル（enclosure の各 README の「設計を変える」で out/ に出力したもの）
enclosure/**/out/

# KiCad のバックアップ・キャッシュ
*-backups/
*.kicad_prl
fp-info-cache
_autosave-*
*.lck

# Eagle のバックアップ
*.b#?
*.s#?

# macOS などが作るファイル
.DS_Store
Thumbs.db
*.swp
